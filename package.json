    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsqr": "1.4.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "4.1.12"
  }
}
